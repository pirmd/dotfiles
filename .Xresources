! .Xresources (2012-05-12)

! ===== Generic X11 settings (Selenized light) =====
! normal colors: "black", red, green, yellow, blue, magenta, cyan, "white"
*color0:   #ece3cc
*color1:   #d2212d
*color2:   #489100
*color3:   #ad8900
*color4:   #0072d4
*color5:   #ca4898
*color6:   #009c8f
*color7:   #909995

! bright/bold versions of colors
*color8:   #d5cdb6
*color9:   #cc1729
*color10:  #428b00
*color11:  #a78300
*color12:  #006dce
*color13:  #c44392
*color14:  #00978a
*color15:  #3a4d53

*background:  #fbf3db
*foreground:  #53676d
*cursorColor: #53676d

! ===== XTerm =====
XTerm*faceName: monospace
XTerm*faceSize: 8
XTerm*renderFont: true
XTerm*scrollBar: false
